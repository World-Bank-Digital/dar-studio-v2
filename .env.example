# Copy to .env for local development. Never commit the filled-in file.

# Master secret for encrypting stored provider API keys (AES-256-GCM).
# Unset, the app still runs but stores keys in the clear and says so on the
# Settings page. Use at least 16 characters; 32+ random bytes is better.
#   openssl rand -base64 48
DAR_KEY_SECRET=

# Postgres connection string. Unset, the app falls back to embedded PGLite,
# which is ephemeral — fine for local work, never for a deployment.
DATABASE_URL=

# Optional. When present, a platform xAI key is offered on the Settings page in
# addition to whatever keys the user brings. Not required: users supply their
# own Claude / GPT / Gemini / Grok / OpenRouter keys through the interface.
XAI_API_KEY=

# Optional. Set on deploy so share cards resolve; injected by the platform.
VITE_PUBLIC_HOSTNAME=

# Optional. Directory for QA screenshots. Defaults to <repo>/screenshots.
SCREENSHOT_DIR=

# Optional. Resend API key for auth emails (signup verification + sign-in
# notifications). Unset, emails are logged to the server console instead
# ("[mailer:dev]") and nothing is sent.
RESEND_API_KEY=

# Optional. Sender for auth emails. Defaults to Resend's onboarding sender,
# which only delivers to the Resend account owner's own address until a
# domain is verified.
EMAIL_FROM=
