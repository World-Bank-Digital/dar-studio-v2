# Copy to .env for local development. Never commit the filled-in file.

# Master secret for encrypting stored provider API keys (AES-256-GCM).
# Unset, the app still runs but stores keys in the clear and says so on the
# Settings page. Netlify deployment requires at least 32 characters.
#   openssl rand -base64 48
DAR_KEY_SECRET=

# Postgres connection string. Unset, the app falls back to embedded PGLite,
# which is ephemeral — fine for local work, never for a deployment.
DATABASE_URL=

# Optional locally; required for Netlify builds. Use Neon's direct (unpooled)
# connection for the serialized deploy-time migration pass.
MIGRATION_DATABASE_URL=

# Authentication is enabled for deployments. Use the exact public origin (no
# trailing path) and a stable random secret of at least 32 characters.
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Optional deployed Google/X federation. The baked preview client is never used
# when BETTER_AUTH_URL is set. Set the Vite flag to false for email/password-only
# staging, or set it to true and configure all three broker values.
VITE_GROK_AUTH_ENABLED=false
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Comma-separated operators allowed to manage shared team keys.
DAR_ADMIN_EMAILS=

# Netlify authorizes downloads, then returns a 60-second capability for the
# browser to present only in the Ohio Render gateway Authorization header. This
# keeps valid Stage 8 bundles outside serverless limits and bearer values out of URLs.
# Configure the same random secret on both services.
ARTIFACT_GATEWAY_URL=
ARTIFACT_DELIVERY_SECRET=
# Render gateway only: exact Netlify app HTTPS origin allowed by CORS.
APP_ORIGIN=

# Optional. When present, a platform xAI key is offered on the Settings page in
# addition to whatever keys the user brings. Not required: users supply their
# own Claude / GPT / Gemini / Grok / OpenRouter keys through the interface.
XAI_API_KEY=

# Optional. Set on deploy so share cards resolve; injected by the platform.
VITE_PUBLIC_HOSTNAME=

# Optional. Directory for QA screenshots. Defaults to <repo>/screenshots.
SCREENSHOT_DIR=

# Optional. Resend API key for auth emails (signup verification + sign-in
# notifications). Unset, emails are logged to the server console instead
# ("[mailer:dev]") and nothing is sent.
RESEND_API_KEY=

# Optional. Sender for auth emails. Defaults to Resend's onboarding sender,
# which only delivers to the Resend account owner's own address until a
# domain is verified.
EMAIL_FROM=
