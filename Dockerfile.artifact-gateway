# Keep the gateway on the same immutable Node base as the worker image.
FROM node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752

LABEL org.opencontainers.image.title="DAR Studio Stage 8 artifact gateway"
LABEL org.opencontainers.image.description="Hash-verified delivery of immutable DAR workflow artifacts"

ENV NODE_ENV=production
ENV PORT=10000

WORKDIR /app

COPY --chown=node:node deploy/artifact-gateway/package.json deploy/artifact-gateway/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

COPY --chown=node:node scripts/artifact-gateway.ts ./scripts/artifact-gateway.ts
COPY --chown=node:node scripts/deployment-url-policy.mjs ./scripts/deployment-url-policy.mjs
COPY --chown=node:node src/lib/damm-v17/artifact-delivery-contract.ts ./src/lib/damm-v17/artifact-delivery-contract.ts
COPY --chown=node:node src/lib/damm-v17/artifact-delivery-token.ts ./src/lib/damm-v17/artifact-delivery-token.ts
COPY --chown=node:node src/lib/damm-v17/artifact-limits.ts ./src/lib/damm-v17/artifact-limits.ts
COPY --chown=node:node src/lib/damm-v17/workflow.ts ./src/lib/damm-v17/workflow.ts
COPY --chown=node:node src/lib/damm-v17/runs.ts ./src/lib/damm-v17/runs.ts
COPY --chown=node:node src/data/run_budget.json ./src/data/run_budget.json
COPY --chown=node:node src/data/run_vendors.json ./src/data/run_vendors.json
COPY --chown=node:node src/data/dar_workflow_v1.json ./src/data/dar_workflow_v1.json
COPY --chown=node:node src/data/dar_workflow_v1.schema.json ./src/data/dar_workflow_v1.schema.json
COPY --chown=node:node src/data/dar_workflow_manifest.json ./src/data/dar_workflow_manifest.json

USER node
# Resolve the complete runtime graph before an image can be deployed. Importing the
# entry point does not start its server or connect to the database.
RUN node --experimental-strip-types --input-type=module -e "await import('./scripts/artifact-gateway.ts'); await import('pg');"
EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+process.env.PORT+'/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "--experimental-strip-types", "scripts/artifact-gateway.ts"]
