# syntax=docker/dockerfile:1.7

FROM node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS node-deps
WORKDIR /opt/app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS runtime

WORKDIR /opt/app

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DAMM_DATA_ROOT=/var/data \
    DAMM_PIPELINE_PYTHON=/opt/damm-venv/bin/python \
    HOME=/home/darworker

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-dejavu-core \
        fonts-liberation \
        git \
        gosu \
        libreoffice-writer \
        pandoc \
        tini \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-deps /usr/local/bin/node /usr/local/bin/node
COPY --from=node-deps /opt/app/node_modules /opt/app/node_modules
COPY deploy/worker/requirements.lock /opt/app/deploy/worker/requirements.lock

RUN python -m venv /opt/damm-venv \
    && /opt/damm-venv/bin/pip install \
        --no-cache-dir \
        --no-deps \
        --only-binary=:all: \
        --requirement /opt/app/deploy/worker/requirements.lock \
    && /opt/damm-venv/bin/python -B -c \
        "import anthropic, openai, openpyxl; from google import genai"

# The manifest is the only source of the public upstream repository and commit. The
# image carries a clean seed so a runtime disk checkout never depends on outbound Git
# access. Disable every interactive and configured credential path so the build proves
# that the canonical public source is fetchable anonymously.
COPY src/data/damm_model_manifest.json /opt/app/src/data/damm_model_manifest.json
RUN set -eu; \
    git_home="$(mktemp -d)"; \
    chmod 0700 "$git_home"; \
    install -d -m 0700 "$git_home/.config"; \
    export HOME="$git_home"; \
    export XDG_CONFIG_HOME="$git_home/.config"; \
    unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT; \
    export GIT_CONFIG_COUNT=0; \
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1; \
    export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false; \
    repository="$(python -c 'import json; print(json.load(open("/opt/app/src/data/damm_model_manifest.json"))["source"]["repository"])')"; \
    commit="$(python -c 'import json; print(json.load(open("/opt/app/src/data/damm_model_manifest.json"))["source"]["commit"])')"; \
    install -d -m 0755 /opt/damm-seed; \
    git -C /opt/damm-seed init --quiet; \
    git -C /opt/damm-seed remote add origin "$repository"; \
    test "$(git -C /opt/damm-seed remote get-url --all origin)" = "$repository"; \
    test "$(git -C /opt/damm-seed remote get-url --push --all origin)" = "$repository"; \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false git -C /opt/damm-seed fetch --depth=1 --no-tags origin "$commit"; \
    git -C /opt/damm-seed checkout --detach "$commit"; \
    test "$(git -C /opt/damm-seed rev-parse HEAD)" = "$commit"; \
    git -C /opt/damm-seed fsck --strict --no-dangling; \
    test "$(git -C /opt/damm-seed rev-parse --is-shallow-repository)" = "true"; \
    test "$(git -C /opt/damm-seed rev-list --count --all)" = "1"; \
    test -z "$(git -C /opt/damm-seed tag --list)"; \
    test -z "$(git -C /opt/damm-seed status --porcelain=v1 --untracked-files=all)"; \
    rm -rf -- "$git_home"; \
    git config --system --add safe.directory /opt/damm-seed; \
    git config --system --add safe.directory /opt/damm-seed/.git

# Execute the standalone model-parity program and every upstream unittest directory
# under the same 3.12 interpreter that will run the workflow. -B keeps executable
# bytecode out of the attested source tree.
RUN set -eu; \
    cd /opt/damm-seed; \
    /opt/damm-venv/bin/python -B model/test_model_parity.py; \
    /opt/damm-venv/bin/python -B -m unittest discover -s workflow -p 'test_*.py'; \
    /opt/damm-venv/bin/python -B -m unittest discover -s gauntlet/loop-1 -p 'test_*.py'; \
    /opt/damm-venv/bin/python -B -m unittest discover -s gauntlet/loop-1/research_pipeline -p 'test_*.py'

COPY package.json package-lock.json /opt/app/
COPY migrations /opt/app/migrations
COPY scripts /opt/app/scripts
COPY src /opt/app/src
COPY deploy/worker /opt/app/deploy/worker

# Refuse an upstream tree that merely claims the right commit. This applies the app's
# content hashes, version labels, clean-tree rule, and executable-file/symlink checks.
RUN DAMM_PIPELINE_DIR=/opt/damm-seed \
    DAMM_PIPELINE_PYTHON=/opt/damm-venv/bin/python \
    node --experimental-strip-types --input-type=module -e \
      'import("./src/lib/damm-v17/worker.ts").then(({ verifyPipelineMethodology }) => { const result = verifyPipelineMethodology(); if (!result.ok) throw new Error(result.reason); })'

RUN groupadd --gid 10001 darworker \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/darworker darworker \
    && install -d -m 0755 -o darworker -g darworker /var/data

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/sh", "/opt/app/deploy/worker/entrypoint.sh"]
